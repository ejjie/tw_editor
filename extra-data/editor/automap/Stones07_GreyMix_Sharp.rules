[THIN HOOK]

[• 1 thick +1]
# Added for Design it! (tw-editor). Run on a layer that has a tile wherever there is hook. Keeps only the hook a
# tileset without 1 tile wide pieces can't draw, plus 1 more tile towards the rest of the hook, as stone tile 16:
# - every tile that is not part of any full 2x2 square (1 tile thick parts, tiles joined only by a corner step)
# - both tiles of every pair of neighbours that are not part of a full 2x2 square together (1 tile wide necks
#   between two blocks)
# Run a stone config from WHOLE MAP after it to draw the stones. Outside the map counts as solid.

# every hook tile is a candidate
Index 2

# not a candidate when it is part of a full 2x2 square (4 squares hold a tile)
NewRun
Index 1
Pos 0 0 INDEX 2
Pos 1 0 NOTINDEX 0
Pos 0 1 NOTINDEX 0
Pos 1 1 NOTINDEX 0

Index 1
Pos 0 0 INDEX 2
Pos -1 0 NOTINDEX 0
Pos 0 1 NOTINDEX 0
Pos -1 1 NOTINDEX 0

Index 1
Pos 0 0 INDEX 2
Pos 1 0 NOTINDEX 0
Pos 0 -1 NOTINDEX 0
Pos 1 -1 NOTINDEX 0

Index 1
Pos 0 0 INDEX 2
Pos -1 0 NOTINDEX 0
Pos 0 -1 NOTINDEX 0
Pos -1 -1 NOTINDEX 0

